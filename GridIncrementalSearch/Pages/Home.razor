@page "/"

@using Syncfusion.Blazor.Grids

<div class="page-shell">
    <header class="page-intro">
        <h3 class="grid-page-title">Grid Incremental Search</h3>
    </header>

    <section class="feature-panel" aria-labelledby="features-heading">
        <div class="feature-heading">
            <h4 id="features-heading">Features enabled</h4>
            <span class="ready-label"><span aria-hidden="true"></span>Ready to explore</span>
        </div>
        <ul class="feature-list">
            <li class="feature-chip"><span aria-hidden="true">✓</span>Incremental search</li>
            <li class="feature-chip"><span aria-hidden="true">✓</span>Virtualization</li>
            <li class="feature-chip"><span aria-hidden="true">✓</span>Excel filtering</li>
            <li class="feature-chip"><span aria-hidden="true">✓</span>Single selection</li>
            <li class="feature-chip"><span aria-hidden="true">✓</span>Column template</li>
        </ul>
    </section>

    <section class="grid-card" aria-labelledby="grid-heading">
        <div class="grid-card-header">
            <div>
                <h2 id="grid-heading">Explore sample data</h2>
                <p>Type a letter while the grid is focused to jump to a matching category.</p>
            </div>
        </div>

        <div class="grid-wrapper">
            <SfGrid TValue="ColumnPickerItem" @onkeydown="OnGridKeyDown" @ref="Grid" AllowFiltering="true"
                    DataSource="@GridData"
                    Height="400"
                    AllowSelection="true"
                    EnableVirtualization="true">
                <GridFilterSettings Type="FilterType.Excel"></GridFilterSettings>
                <GridSelectionSettings Type="SelectionType.Single"></GridSelectionSettings>

                <GridColumns>
                    <GridColumn Field="@nameof(ColumnPickerItem.Category)"
                                HeaderText="Category"
                                Width="300"
                                AllowFiltering="true"
                                AllowSorting="true">
                        <Template>
                            @{
                                var item = (ColumnPickerItem)context;
                                <div class="column-name-template">
                                    <span class="column-icon" aria-hidden="true">▦</span>
                                    <span class="column-text">@item.Category</span>
                                </div>
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </div>
    </section>
</div>




