@page "/"

@using System.Globalization
@using System.Reflection
@using Syncfusion.Blazor.Grids
@implements IDisposable

<div class="page-shell">
    <header class="page-intro">
        <h3 class="grid-page-title">Grid Incremental Search</h3>
    </header>

    <section class="feature-panel" aria-labelledby="features-heading">
        <div class="feature-heading">
            <h4 id="features-heading">Features enabled</h4>
            <span class="ready-label"><span aria-hidden="true"></span>Ready to explore</span>
        </div>
        <ul class="feature-list">
            <li class="feature-chip"><span aria-hidden="true">✓</span>Incremental search</li>
            <li class="feature-chip"><span aria-hidden="true">✓</span>Virtualization</li>
            <li class="feature-chip"><span aria-hidden="true">✓</span>Excel filtering</li>
            <li class="feature-chip"><span aria-hidden="true">✓</span>Single selection</li>
            <li class="feature-chip"><span aria-hidden="true">✓</span>Column template</li>
        </ul>
    </section>

    <section class="grid-card" aria-labelledby="grid-heading">
        <div class="grid-card-header">
            <div>
                <h2 id="grid-heading">Explore sample data</h2>
                <p>Type a letter while the grid is focused to jump to a matching category.</p>
            </div>
        </div>

        <div class="grid-wrapper">
            <SfGrid TValue="ColumnPickerItem" @onkeydown="OnGridKeyDown" @ref="Grid" AllowFiltering="true"
                    DataSource="@GridData"
                    Height="400"
                    AllowSelection="true"
                    EnableVirtualization="true">
                <GridFilterSettings Type="FilterType.Excel"></GridFilterSettings>
                <GridSelectionSettings Type="SelectionType.Single"></GridSelectionSettings>

                <GridColumns>
                    <GridColumn Field="@nameof(ColumnPickerItem.Id)"
                                HeaderText="ID"
                                IsPrimaryKey="true"
                                Visible="false" />
                    <GridColumn Field="@nameof(ColumnPickerItem.Category)"
                                HeaderText="Category"
                                Width="300"
                                AllowFiltering="true"
                                AllowSorting="true">
                        <Template>
                            @{
                                var item = (ColumnPickerItem)context;
                                <div class="column-name-template">
                                    <span class="column-icon" aria-hidden="true">▦</span>
                                    <span class="column-text">@item.Category</span>
                                </div>
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </div>
    </section>
</div>




@code {


    private SfGrid<ColumnPickerItem>? Grid;

    private string searchBuffer = "";
    private int searchStartIndex = -1;
    private CancellationTokenSource? pendingSearchCts;

    public List<ColumnPickerItem> GridData { get; set; }
    private int currentSelectedIndex = -1;
    private DateTime lastKeyTime = DateTime.MinValue;
    private static readonly TimeSpan SearchBufferDelay = TimeSpan.FromMilliseconds(500);

    private async Task OnGridKeyDown(KeyboardEventArgs args)
    {
        if (string.IsNullOrEmpty(args.Key) ||
            args.Key.Length != 1 ||
            args.CtrlKey ||
            args.AltKey ||
            args.MetaKey)
            return;

        var selectedRowIndexes = await Grid!.GetSelectedRowIndexesAsync();
        var selectedIndex = selectedRowIndexes.Count > 0
            ? selectedRowIndexes[0]
            : -1;
        if (selectedIndex != currentSelectedIndex)
        {
            currentSelectedIndex = selectedIndex;
            searchBuffer = string.Empty;
            searchStartIndex = selectedIndex;
        }

        var currentTime = DateTime.UtcNow;
        if ((currentTime - lastKeyTime) > SearchBufferDelay)
        {
            searchBuffer = string.Empty;
            searchStartIndex = currentSelectedIndex;
        }

        if (searchBuffer.Length == 1 &&
            searchBuffer.Equals(args.Key,
                StringComparison.OrdinalIgnoreCase))
        {
            searchBuffer = string.Empty;
            searchStartIndex = currentSelectedIndex;
        }

        if (searchBuffer.Length == 0)
            searchStartIndex = currentSelectedIndex;

        searchBuffer += args.Key;
        lastKeyTime = currentTime;

        var query = searchBuffer;
        var startIndex = searchStartIndex;
        var debounceCts = new CancellationTokenSource();
        var previousCts = pendingSearchCts;
        pendingSearchCts = debounceCts;
        previousCts?.Cancel();

        try
        {
            await Task.Delay(SearchBufferDelay, debounceCts.Token);
            if (pendingSearchCts == debounceCts)
                await SearchAndSelect(query, startIndex, debounceCts.Token);
        }
        catch (OperationCanceledException) when (debounceCts.IsCancellationRequested)
        {
        }
        finally
        {
            if (pendingSearchCts == debounceCts)
                pendingSearchCts = null;

            debounceCts.Dispose();
        }
    }

    private async Task SearchAndSelect(string text, int startIndex, CancellationToken cancellationToken)
    {
        IEnumerable<ColumnPickerItem> records = GridData;
        if (Grid!.AllowFiltering && Grid.FilterSettings?.Columns?.Count > 0)
        {
            var filteredData = await Grid.GetFilteredRecordsAsync(isStrictFiltering: true);
            if (filteredData is not IEnumerable<object> filteredRecords)
                throw new InvalidOperationException("The grid returned filtered records in an unsupported format.");

            records = filteredRecords.OfType<ColumnPickerItem>().ToList();
        }

        var searchRecords = records.ToList();
        if (searchRecords.Count == 0)
            return;

        var columns = (await Grid.GetColumnsAsync())
            .Where(column => column.Visible && !string.IsNullOrWhiteSpace(column.Field))
            .ToList();

        for (var offset = 1; offset <= searchRecords.Count; offset++)
        {
            cancellationToken.ThrowIfCancellationRequested();
            var index = (startIndex + offset + searchRecords.Count) % searchRecords.Count;
            if (!columns.Any(column => ColumnStartsWith(searchRecords[index], column.Field, text)))
                continue;

            currentSelectedIndex = index;

            await Grid.SelectRowAsync(index);
            cancellationToken.ThrowIfCancellationRequested();
            await Grid.ScrollIntoViewAsync(rowIndex: index);
            return;
        }
    }

    private static bool ColumnStartsWith(ColumnPickerItem order, string field, string text)
    {
        object? value = order;
        foreach (var propertyName in field.Split('.'))
        {
            if (value is null)
                return false;

            var property = value.GetType().GetProperty(
                propertyName,
                BindingFlags.Instance | BindingFlags.Public | BindingFlags.IgnoreCase);
            if (property is null)
                return false;

            value = property.GetValue(value);
        }

        var searchableValue = Convert.ToString(value, CultureInfo.CurrentCulture);
        var boolvalue = searchableValue?.StartsWith(text, StringComparison.OrdinalIgnoreCase);
        return searchableValue?.StartsWith(text, StringComparison.OrdinalIgnoreCase) == true;
    }

    public void Dispose()
    {
        pendingSearchCts?.Cancel();
    }
    protected override void OnInitialized()
    {
        GridData = GenerateSampleData();
    }
    private static List<ColumnPickerItem> GenerateSampleData()
    {
        var data = new List<ColumnPickerItem>();

        // Financial columns
        var financialColumns = new[]
        {
            "Account Balance", "Account Number", "Annual Revenue", "Asset Value",
            "Audit Trail", "Budget Variance", "Cash Flow", "Cost Center",
            "Debit Amount", "Depreciation Rate", "Discount Percentage", "Expense Ratio",
            "Financial Year", "Fixed Assets", "Forecast Amount", "Fund Allocation",
            "General Ledger", "Gross Margin", "Income Statement", "Invoice Amount",
            "Journal Entry", "Ledger Account", "Liability Amount", "Line Item Total"
        };

        var operationalColumns = new[]
        {
            "Abandonment Area", "Batch ID", "Batch Status", "Business Unit",
            "Campaign Code", "Capacity Utilization", "Channel Name", "Completion Rate",
            "Database Name", "Delivery Date", "Department Code", "Department Name",
            "Dispatch Time", "Document ID", "Document Status", "Domain Name",
            "Employee ID", "Employee Name", "Equipment ID", "Error Code",
            "Event Name", "Event Status", "Exception Type", "Execution Time",
            "Facility Name", "Field Active Indicator", "Field Audit", "Field Batch"
        };

        var administrativeColumns = new[]
        {
            "Approval Status", "Approved By", "Approval Date", "Audit Log",
            "Authorization Level", "Authority Name", "Branch Code", "Branch Name",
            "Compliance Status", "Configuration Setting", "Contract ID", "Control Type",
            "Created By", "Created Date", "Critical Flag", "Custom Attribute",
            "Data Classification", "Data Owner", "Data Quality Score", "Data Source",
            "Declined By", "Description", "District Code", "Document Type"
        };

        var systemColumns = new[]
        {
            "API Endpoint", "Application ID", "Application Name", "Archive Flag",
            "Attachment ID", "Attachment Name", "Attribute Name", "Audit Timestamp",
            "Authentication Method", "Authorization Token", "Availability Status", "Backup Status",
            "Base URL", "Billing Cycle", "Binary Data", "Build Number",
            "Cache Key", "Cache Status", "Change Log", "Change Request ID",
            "Cluster Name", "Code Version", "Column Alias", "Column Display Name",
            "Column Type", "Command Line", "Communication Protocol", "Compression Type",
            "Configuration Key", "Connection String", "Connection Timeout", "Connector ID"
        };

        int id = 1;

        // Add Financial columns
        foreach (var col in financialColumns)
        {
            data.Add(new ColumnPickerItem
            {
                Id = id++,
                Category = col
            });
        }

        // Add Operational columns
        foreach (var col in operationalColumns)
        {
            data.Add(new ColumnPickerItem
            {
                Id = id++,
                Category = col
            });
        }

        // Add Administrative columns
        foreach (var col in administrativeColumns)
        {
            data.Add(new ColumnPickerItem
            {
                Id = id++,
                Category = col
            });
        }

        // Add System columns
        foreach (var col in systemColumns)
        {
            data.Add(new ColumnPickerItem
            {
                Id = id++,
                Category = col
            });
        }

        var existingColumnNames = data
            .Select(item => item.Category)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var entities = new[]
        {
            "Account", "Asset", "Audit", "Bank", "Billing", "Budget", "Business",
            "Campaign", "Cash", "Channel", "Client", "Contract", "Customer", "Data",
            "Delivery", "Department", "Device", "Document", "Employee", "Equipment",
            "Expense", "Facility", "Financial", "Inventory", "Invoice", "Item",
            "Location", "Order", "Payment", "Product", "Project", "Purchase",
            "Region", "Report", "Sales", "Security", "Service", "Shipment",
            "Supplier", "System", "Tax", "User", "Vendor", "Warehouse", "Workflow"
        };
        var attributes = new[]
        {
            "ID", "Name", "Code", "Number", "Status", "Type", "Category",
            "Date", "Created Date", "Updated Date", "Owner", "Manager",
            "Amount", "Balance", "Rate", "Quantity", "Description",
            "Reference", "Location", "Source"
        };

        foreach (var entity in entities)
        {
            foreach (var attribute in attributes)
            {
                var category = $"{entity} {attribute}";
                if (!existingColumnNames.Add(category))
                    continue;

                data.Add(new ColumnPickerItem
                {
                    Id = id++,
                    Category = category
                });

                if (data.Count == 500)
                    return data.OrderBy(item => item.Category, StringComparer.OrdinalIgnoreCase).ToList();
            }
        }

        return data.OrderBy(item => item.Category, StringComparer.OrdinalIgnoreCase).ToList();
    }

    public class ColumnPickerItem
    {
        public int Id { get; set; }
        public string Category { get; set; } = string.Empty;
    }
}
